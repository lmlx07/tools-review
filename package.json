{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "build:en": "hexo generate --config _config.en.yml",
    "build:all": "bash tools/build-bilingual.sh",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "deploy:all": "bash tools/build-bilingual.sh && npx hexo deploy",
    "server": "hexo server",
    "translate": "python tools/translate-via-browser.py"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-seo": "^2.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.4",
    "hexo-theme-landscape": "^1.0.0"
  }
}
